<div class="container mt-5">
  <div class="card shadow border-0">
    <div class="card-header bg-primary text-white">
      <h3 class="mb-0">Option Values for "<%= @option_type.name %>"</h3>
    </div>

    <div class="card-body">
      <h5 class="text-primary">Add New Option Value</h5>

      <%= form_with model: [@option_type, @option_value], local: true do |form| %>
        <div class="row g-3 align-items-end mb-4">
          <div class="col-md-6">
            <%= form.label :value, class: "form-label" %>
            <%= form.text_field :value, class: "form-control", placeholder: "Enter option value" %>
          </div>
          <div class="col-md-auto">
            <%= form.submit "Add Value", class: "btn btn-success" %>
          </div>
        </div>
      <% end %>

      <hr>

      <h5 class="text-primary">All Option Values</h5>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Value</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @option_values.each do |value| %>
              <tr>
                <td><%= value.id %></td>
                <td><%= value.value %></td>
                <td class="text-center">
                  <%= link_to "Delete",
                    option_type_option_value_path(@option_type, value),
                    method: :delete,
                    data: { confirm: "Are you sure?" },
                    class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card-footer bg-light text-end">
      <%= link_to "Back to Option Types", option_types_path, class: "btn btn-outline-primary" %>
    </div>
  </div>
</div>
