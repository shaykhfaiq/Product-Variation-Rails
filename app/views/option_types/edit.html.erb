<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Edit Option Type</h4>
        </div>

        <div class="card-body">
          <%= form_with model: @option_type, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, class: "form-control", placeholder: "Enter option type name" %>
            </div>

            <div class="d-flex justify-content-between">
              <%= form.submit "Update", class: "btn btn-success" %>
              <%= link_to "Back", option_types_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
